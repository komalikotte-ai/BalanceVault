generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED

  @@map("user_status")
}

enum AccountType {
  CUSTOMER
  SYSTEM

  @@map("account_type")
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("account_status")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("request_status")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED

  @@map("transaction_status")
}

enum LedgerSide {
  DEBIT
  CREDIT

  @@map("ledger_side")
}

model AppUser {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  openingRequests       AccountOpeningRequest[] @relation("ApplicantRequests")
  reviewedRequests      AccountOpeningRequest[] @relation("ReviewedRequests")
  ownedAccounts         Account[]               @relation("AccountOwner")
  initiatedTransactions MoneyTransaction[]      @relation("TransactionInitiator")
  auditEvents           AuditEvent[]            @relation("AuditActor")
  auditorAccess         AuditorAccountAccess[]  @relation("Auditor")
  grantedAuditorAccess  AuditorAccountAccess[]  @relation("AccessGrantedBy")

  @@index([role, status])
  @@map("app_users")
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  accountNumber String        @unique @map("account_number") @db.VarChar(32)
  ownerUserId   String?       @map("owner_user_id") @db.Uuid
  accountType   AccountType   @map("account_type")
  currency      String        @default("INR") @db.Char(3)
  balancePaise  BigInt?       @map("balance_paise")
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  owner                   AppUser?               @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  openingRequest          AccountOpeningRequest? @relation("RequestAccount")
  sourceTransactions      MoneyTransaction[]     @relation("SourceAccount")
  destinationTransactions MoneyTransaction[]     @relation("DestinationAccount")
  ledgerEntries           LedgerEntry[]
  auditorAccess           AuditorAccountAccess[]

  @@index([ownerUserId, status])
  @@index([accountType, status])
  @@map("accounts")
}

model AccountOpeningRequest {
  id              String        @id @default(uuid()) @db.Uuid
  applicantUserId String        @map("applicant_user_id") @db.Uuid
  status          RequestStatus @default(PENDING)
  reviewerUserId  String?       @map("reviewer_user_id") @db.Uuid
  accountId       String?       @unique @map("account_id") @db.Uuid
  reviewNote      String?       @map("review_note") @db.VarChar(500)
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(6)

  applicant AppUser  @relation("ApplicantRequests", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewer  AppUser? @relation("ReviewedRequests", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  account   Account? @relation("RequestAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([applicantUserId, status])
  @@index([status, requestedAt])
  @@map("account_opening_requests")
}

model MoneyTransaction {
  id                   String            @id @default(uuid()) @db.Uuid
  transactionType      TransactionType   @map("transaction_type")
  status               TransactionStatus @default(PENDING)
  amountPaise          BigInt            @map("amount_paise")
  currency             String            @default("INR") @db.Char(3)
  sourceAccountId      String            @map("source_account_id") @db.Uuid
  destinationAccountId String            @map("destination_account_id") @db.Uuid
  initiatedByUserId    String            @map("initiated_by_user_id") @db.Uuid
  idempotencyKey       String            @map("idempotency_key") @db.VarChar(128)
  description          String?           @db.VarChar(255)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)

  sourceAccount      Account       @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account       @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  initiatedBy        AppUser       @relation("TransactionInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]

  @@unique([initiatedByUserId, idempotencyKey])
  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([status, createdAt])
  @@map("money_transactions")
}

model LedgerEntry {
  id            String     @id @default(uuid()) @db.Uuid
  transactionId String     @map("transaction_id") @db.Uuid
  accountId     String     @map("account_id") @db.Uuid
  entrySide     LedgerSide @map("entry_side")
  amountPaise   BigInt     @map("amount_paise")
  currency      String     @default("INR") @db.Char(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction MoneyTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId, entrySide])
  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  details     Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model AuditorAccountAccess {
  id              String   @id @default(uuid()) @db.Uuid
  auditorUserId   String   @map("auditor_user_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  grantedByUserId String   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  auditor   AppUser @relation("Auditor", fields: [auditorUserId], references: [id], onDelete: Restrict)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  grantedBy AppUser @relation("AccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([auditorUserId, accountId])
  @@index([accountId])
  @@map("auditor_account_access")
}
